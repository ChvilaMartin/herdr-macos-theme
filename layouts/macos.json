{
  "id": "root",
  "cloned_from": {
    "name": "herdr-glass",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "macos-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "macos-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "macos-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "macos-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 97
          }
        }
      ],
      "size": {
        "px": 250
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "row",
          "children": [
            {
              "id": "tab-strip",
              "type": "block",
              "content": {
                "mod": "macos-tabs"
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 42
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "macos-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#ffffff",
                  "border": {
                    "width": 1,
                    "color": "#ffffff80"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#007aff8c"
                  },
                  "radius": 16,
                  "gap": 10,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 340
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": "#ffffff73",
              "border": {
                "width": 1,
                "color": "#ffffff8c"
              },
              "radius": 16,
              "shadow": "sm"
            }
          ],
          "gap": 10
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "macos-status"
          },
          "size": {
            "px": 30
          }
        }
      ],
      "gap": 10,
      "resizable": false
    }
  ],
  "background": "#f4f4f7a6",
  "padding": 10,
  "theme": "macos",
  "colors": {
    "canvas": "#00000000",
    "chrome": "#00000000",
    "background": "#ffffff00"
  },
  "font": "SF Mono",
  "font_size": 13,
  "font_weight": 400,
  "terminal_line_height": 1.1,
  "terminal_padding": [
    12,
    14
  ],
  "terminal_opacity": 0,
  "gap": 10,
  "titlebar": "none",
  "traffic_lights": [
    24,
    26
  ],
  "preview": "layouts/macos.svg",
  "toast": "macos-toast",
  "window_blur": true,
  "terminal_menu": "macos-menu",
  "ui_font": ".SF NS"
}
